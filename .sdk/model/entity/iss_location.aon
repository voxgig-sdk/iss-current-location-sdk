# Entity: iss_location

main: kit: entity: iss_location: {

  alias: field: {}

  fields: [
    {
      name: "latitude"
      req: true
      short: "Latitude coordinate of the ISS"
      type: "`$STRING`"
    }
    {
      name: "longitude"
      req: true
      short: "Longitude coordinate of the ISS"
      type: "`$STRING`"
    }
  ]

  name: "iss_location"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "callback"
                orig: "callback"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/iss-now.json"
          parts: [
            "iss-now.json"
          ]
          select: {
            exist: [
              "callback"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.iss_position`"
          }
        }
      ]
    }
  }



}
